{
  "expo": {
    "name": "Explore",
    "slug": "Explore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/jornal.png",
    "scheme": "Explore",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "",
        "backgroundImage": "",
        "monochromeImage": ""
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.moisesdamasceno.explore"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon_news.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec3a28ef-9efb-43e7-a597-511d32d04dc1"
      }
    }
  }
}
